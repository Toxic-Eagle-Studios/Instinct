# Optional. AI Studio Build normally provisions GEMINI_API_KEY as a server-side secret.
# Never prefix this variable with VITE_ (that would expose it in the browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3001

# Optional Firebase setup, only needed for Google sign-in and cross-device sync.
# Firebase WEB config is public by design; security comes from Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
